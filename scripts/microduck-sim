#!/bin/sh
# Keep Unix sockets and the upstream shell's scene arguments on a short, space-free path.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# Shared platform setup also preserves the original Mac short path when it belongs here.
platform_env="$(python3 "$ROOT/bridge/platform_support.py" shell-env)"
eval "$platform_env"
if [ "${1:-}" = doctor ]; then
    exec python3 "$ROOT/bridge/platform_support.py" doctor
fi
if [ "${1:-}" = down ] && [ -z "${DUCK_SIM_PORT:-}" ]; then
    DUCK_SIM_PORT="$(python3 "$ROOT/bridge/platform_support.py" desktop-body-port)"
    export DUCK_SIM_PORT
fi
if [ "${1:-}" = prepare ]; then
    # Installer mode builds without starting or stopping any robot process.
    (cd "$ROOT/microduck" && cargo build --locked -p robotd -p robotctl -p tof -p sounds -p configd -p updater)
    if [ ! -f "$ROOT/microduck/policies/velstand.onnx" ]; then
        sh "$ROOT/microduck/scripts/seed-policies.sh" "$DUCK_SIM_STATE/policies"
        [ -f "$DUCK_SIM_STATE/policies/current/velstand.onnx" ] || {
            echo "Policy download incomplete; retry installation when the network is available." >&2
            exit 1
        }
    fi
    exit 0
fi
if [ "${1:-}" = serve ]; then
    # Keep a foreground owner alive: task runners may reap detached children when the
    # startup command exits. Ctrl-C stops only this simulator's pidfile-owned processes.
    shift
    if [ "${1:-}" = --maze ]; then
        export DUCK_SIM_SCENE="$SHORT/scenes/maze.xml"
        shift
    fi
    trap '"$ROOT/microduck/scripts/duck-sim" down; exit 0' INT TERM
    "$ROOT/microduck/scripts/duck-sim" "$@"
    if [ -n "${MICRODUCK_DESKTOP_READY_FILE:-}" ]; then
        touch "$MICRODUCK_DESKTOP_READY_FILE"
    fi
    while [ -f "$DUCK_SIM_STATE/body.pid" ] && kill -0 "$(cat "$DUCK_SIM_STATE/body.pid")" 2>/dev/null; do
        sleep 2
    done
    exit 0
fi
exec "$ROOT/microduck/scripts/duck-sim" "$@"

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>MicroduckV7RC</AssemblyName><ApplicationIcon>../assets/app-icon.ico</ApplicationIcon>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../version.txt').Trim())</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../ui.json" LogicalName="ui.json" />
    <EmbeddedResource Include="../version.txt" LogicalName="version.txt" />
    <EmbeddedResource Include="../common/install-linux.sh" LogicalName="install-linux.sh" />
    <EmbeddedResource Include="../../dist/payload.zip" LogicalName="payload.zip" />
    <EmbeddedResource Include="../../dist/payload.sha256" LogicalName="payload.sha256" />
    <EmbeddedResource Include="../../docs/how-to.html" LogicalName="how-to.html" />
    <EmbeddedResource Include="../../docs/INSTALL.zh-TW.md" LogicalName="INSTALL.zh-TW.md" WithCulture="false" />
    <EmbeddedResource Include="../../docs/INSTALL.zh-CN.md" LogicalName="INSTALL.zh-CN.md" WithCulture="false" />
    <EmbeddedResource Include="../../docs/INSTALL.en.md" LogicalName="INSTALL.en.md" WithCulture="false" />
    <EmbeddedResource Include="../../docs/INSTALL.ja.md" LogicalName="INSTALL.ja.md" WithCulture="false" />
    <EmbeddedResource Include="../assets/app-icon.ico" LogicalName="app-icon.ico" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.md" LogicalName="notices/THIRD_PARTY_NOTICES.txt" />
    <EmbeddedResource Include="../../licenses/Apache-2.0.txt" LogicalName="notices/Apache-2.0.txt" />
  </ItemGroup>
  <Target Name="EmbedRuntimeNotices" BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_CorePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_DesktopPack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
    <Error Condition="'@(_CorePack)' == '' or '@(_DesktopPack)' == ''"
           Text="Cannot locate the runtime packs for third-party notices." />
    <PropertyGroup>
      <_WpfNoticeVersion>@(_DesktopPack->'%(NuGetPackageVersion)')</_WpfNoticeVersion>
      <_WpfNoticeFile>$(IntermediateOutputPath)third-party/wpf-$(_WpfNoticeVersion).txt</_WpfNoticeFile>
    </PropertyGroup>
    <!-- The Windows Desktop runtime pack carries LICENSE but omits the WPF notices. -->
    <DownloadFile SourceUrl="https://raw.githubusercontent.com/dotnet/wpf/v$(_WpfNoticeVersion)/THIRD-PARTY-NOTICES.TXT"
                  DestinationFolder="$(IntermediateOutputPath)third-party" DestinationFileName="wpf-$(_WpfNoticeVersion).txt"
                  Condition="!Exists('$(_WpfNoticeFile)')" />
    <ItemGroup>
      <EmbeddedResource Include="@(_CorePack->'%(PackageDirectory)/LICENSE.TXT')" LogicalName="notices/DotNet-Runtime-LICENSE.txt" />
      <EmbeddedResource Include="@(_CorePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" LogicalName="notices/DotNet-Runtime-NOTICES.txt" />
      <EmbeddedResource Include="@(_DesktopPack->'%(PackageDirectory)/LICENSE')" LogicalName="notices/WPF-LICENSE.txt" />
      <EmbeddedResource Include="$(_WpfNoticeFile)" LogicalName="notices/WPF-NOTICES.txt" />
    </ItemGroup>
  </Target>
</Project>
